# ==============================================================================
# 1. SECRETS, API KEYS, WALLET CREDENTIALS & PASSWORDS (CRITICAL)
# ==============================================================================
# Environment files (OpenAI, Infura, Alchemy, etc.)
.env
.env.*
!.env.example
*.env

# Ethereum keystores, raw private keys & mnemonics
*keystore*
*wallet*.json
*credentials*
*.key
*.pem
*.pfx
*.p12
secrets.json
secret.txt
mnemonic.txt
seed.txt
private_key*

# Spring Boot local/secret profiles
application-local.yml
application-local.properties
application-secret.yml
application-secret.properties

# Logs & crash dumps (prevents accidental secret leaks in stack traces)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

